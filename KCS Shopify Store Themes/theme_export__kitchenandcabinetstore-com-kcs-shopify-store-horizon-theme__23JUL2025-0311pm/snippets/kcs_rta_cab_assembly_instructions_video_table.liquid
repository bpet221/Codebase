<!-- 🔲 KCS Video Popup Player -->
<div
  id="kcs-video-modal"
  style="display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:#000000cc; justify-content:center; align-items:center; z-index:9999;"
>
  <video id="kcs-video-player" controls style="max-width:90%; max-height:90%; background:#000;"></video>
</div>

<script>
  function openVideo(url) {
    const modal = document.getElementById('kcs-video-modal');
    const player = document.getElementById('kcs-video-player');
    player.src = url;
    modal.style.display = 'flex';
    modal.onclick = () => {
      modal.style.display = 'none';
      player.pause();
      player.src = '';
    };
  }

  function filterRows(query, checked, forceViewAll) {
    const rows = document.querySelectorAll('.kcs-rta-video-table tbody tr');
    let shownCount = 0;

    rows.forEach((row) => {
      const label = row.cells[0]?.textContent || '';
      const matchesSearch = label.toLowerCase().includes(query);
      const matchesFilter = checked.length === 0 || checked.some((type) => label.includes(type));
      let shouldShow = false;

      if (query || checked.length > 0 || forceViewAll) {
        shouldShow = matchesSearch && matchesFilter;
      } else {
        shouldShow = shownCount < 3;
      }

      row.style.display = shouldShow ? '' : 'none';

      if (shouldShow) shownCount++;
    });
  }
</script>

<style>
  .kcs-rta-video-table thead {
    display: none;
  }

  .kcs-video-thumb {
    position: relative;
    display: inline-block;
    max-height: 30px;
  }

  .kcs-video-thumb img {
    max-height: 30px;
    width: auto;
    object-fit: contain;
    display: block;
    border-radius: 6px;
  }

  .kcs-video-thumb .play-button {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 20px;
    height: 20px;
    transform: translate(-50%, -50%);
    background-image: url('https://cdn.shopify.com/s/files/1/0628/5167/8286/files/KCS_Mini_Icons_and_Favicons_480x480_px_430x.png');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    pointer-events: none;
  }

  .kcs-rta-video-table td:first-child {
    font-family: 'ITC Cheltenham Condensed', serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
    width: 40%;
    padding-right: 20px;
    text-transform: none;
  }
</style>
