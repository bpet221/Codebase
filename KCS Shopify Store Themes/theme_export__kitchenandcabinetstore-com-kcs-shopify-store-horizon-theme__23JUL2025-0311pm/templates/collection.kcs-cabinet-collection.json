hesFilter =\n        checked.length === 0 || checked.some((type) => label.toLowerCase().includes(type.toLowerCase()));\n\n      let shouldShow;\n      if (query || checked.length > 0 || forceViewAll) {\n        shouldShow = matchesSearch && matchesFilter;\n      } else {\n        shouldShow = shownCount < 3;\n      }\n\n      row.style.display = shouldShow ? '' : 'none';\n      if (shouldShow) shownCount++;\n    });\n\n    viewAllToggle.style.display = query || checked.length > 0 || forceViewAll ? 'none' : 'block';\n  }\n\n  \/\/ wire it all up:\n  searchInput.addEventListener('input', () => {\n    forceViewAll = false;\n    filterRows();\n  });\n  checkboxes.forEach((cb) =>\n    cb.addEventListener('change', () => {\n      forceViewAll = false;\n      filterRows();\n    })\n  );\n  viewAllToggle.addEventListener('click', () => {\n    forceViewAll = true;\n    filterRows();\n  });\n\n  \/\/ initial 3-row render on page load:\n  filterRows();\n<\/script>\n<style>\n  .kcs-rta-video-table-wrapper {\n    background: #f5f3eb;\n    border-radius: 12px;\n    padding: 1rem;\n    margin-top: 5px;\n    margin-right: 5px;\n    margin-bottom: 5px;\n    margin-left: 5px;\n  }\n\n  .kcs-video-filter-group {\n    display: flex;\n    align-items: center;\n    gap: 0.5rem;\n    font-size: 8px;\n    font-weight: 500;\n    margin-top: 0.5rem;\n  }\n\n  .kcs-video-filter-group label {\n    font-size: 8px;\n    font-weight: 200;\n    display: flex;\n    align-items: center;\n    gap: 4px;\n  }\n\n  .kcs-video-filter-group input[type='checkbox'] {\n    transform: scale(0.8);\n    accent-color: #35312e;\n    border: 1px solid #35312e;\n  }\n<\/style>"},"blocks":{}}},"block_order":["text_Q8xhjG","custom_liquid_rN7zkf"]},"accordion_row_WAigV4":{"type":"_accordion-row","settings":{"heading":"How to measure you kitchen","open_by_default":false,"icon":"none","image_upload":"shopify:\/\/shop_images\/KCS_Mini_Icons_and_Favicons_501_x_501_px_1.svg","width":20},"blocks":{"text_BfGxMi":{"type":"tex