<div class="kcs-defaults-debug" style="padding: 60px 20px;">
  <h2>Theme Default UI Elements</h2>

  <h3>🔘 Buttons</h3>
  <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
    <a href="#" class="button">Primary Button</a>
    <a href="#" class="button button--secondary">Secondary Button</a>
    <a href="#" class="button button--small">Small Button</a>
    <a href="#" class="button button--large">Large Button</a>
    <a href="#" class="button button--disabled" aria-disabled="true">Disabled</a>
  </div>

  <h3>🏷️ Badges</h3>
  <div style="margin-top: 1rem;">
    <span class="badge badge--sale">Sale</span>
    <span class="badge badge--sold-out">Sold Out</span>
    <span class="badge badge--custom">Custom</span>
  </div>

  <h3>🧾 Form Inputs</h3>
  <form style="margin-top: 1rem;">
    <input type="text" placeholder="Text input" style="margin-bottom: 10px; display: block;" />
    <input type="email" placeholder="Email input" style="margin-bottom: 10px; display: block;" />
    <textarea placeholder="Textarea"></textarea>
    <br />
    <button type="submit" class="button">Submit</button>
  </form>

  <h3>🧱 Cards</h3>
  <div class="card" style="padding: 1rem; border: 1px solid #ccc; max-width: 300px;">
    <h4 class="card__heading">Card Heading</h4>
    <p>This is a simple card to test theme styling.</p>
    <a href="#" class="button button--small">Learn more</a>
  </div>
</div>

