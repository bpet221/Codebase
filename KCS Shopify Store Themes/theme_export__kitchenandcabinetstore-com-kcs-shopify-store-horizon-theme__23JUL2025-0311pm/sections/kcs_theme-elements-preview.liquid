<!--
  🟢 KCS UTILITY > THEME ELEMENTS PREVIEW
  Section: kcs_theme-elements-preview.liquid
  Purpose: Visual test bed for Horizon Theme Settings UI elements
  Date: 2025-07-05
-->

<div style="padding: 60px 20px; max-width: 1200px; margin: auto;">
  <h1>🧪 Theme Settings Preview</h1>

  <h2>🎨 Colors & Typography</h2>
  <p>This is a <strong>strong</strong> paragraph using the theme's body font and color.</p>
  <a href="#">This is a default link</a>
  <ul>
    <li>Unordered list item</li>
    <li>Another item</li>
  </ul>

  <h2>🔤 Headings</h2>
  <h1>Heading 1</h1>
  <h2>Heading 2</h2>
  <h3>Heading 3</h3>
  <h4>Heading 4</h4>

  <h2>🔘 Buttons</h2>
  <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
    <a href="#" class="button">Primary Button</a>
    <a href="#" class="button button--secondary">Secondary Button</a>
    <a href="#" class="button button--small">Small Button</a>
    <a href="#" class="button button--large">Large Button</a>
  </div>

  <h2>🏷️ Badges</h2>
  <div style="margin-top: 1rem; display: flex; gap: 1rem;">
    <span class="badge badge--sale">Sale</span>
    <span class="badge badge--sold-out">Sold Out</span>
    <span class="badge badge--custom">Custom</span>
  </div>

  <h2>🛒 Cart Button + Icons</h2>
  <button class="button">
    <svg class="icon icon-cart" viewBox="0 0 24 24">
      <path d="M6 6h15l-1.5 9h-12z"/>
    </svg>
    Cart
  </button>

  <h2>📝 Input Fields</h2>
  <form>
    <input type="text" placeholder="Text input" class="input">
    <input type="email" placeholder="Email input" class="input">
    <textarea placeholder="Textarea" class="input"></textarea>
  </form>

  <h2>💬 Popovers (Tooltips)</h2>
  <button class="button" data-tooltip="This is a popover">Hover me</button>

  <h2>💵 Prices</h2>
  <div class="price">
    <span class="price__regular">$129.00</span>
  </div>

  <h2>🖼 Product Card (Animation Preview)</h2>
  <div class="card-wrapper" style="max-width: 300px;">
    <div class="card card--standard card--media card--lift">
      <div class="card__inner">
        <div class="card__media">
          <img src="https://via.placeholder.com/400x500.png?text=Product+Image" alt="Mock product">
        </div>
        <div class="card__content">
          <div class="card__information">
            <h3 class="card__heading">Mock Product</h3>
            <div class="price">
              <span class="price__regular">$129.00</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <h2>🔍 Search Input</h2>
  <form>
    <input type="search" placeholder="Search..." class="input">
  </form>

  <h2>🎨 Swatches</h2>
  <div class="swatch">
    <span class="swatch__button" style="background-color: #000;"></span>
    <span class="swatch__button" style="background-color: #af5a3c;"></span>
    <span class="swatch__button" style="background-color: #eee;"></span>
  </div>

  <h2>🔘 Variant Pickers</h2>
  <label for="variant">Choose a size:</label>
  <select id="variant" class="select">
    <option>Small</option>
    <option>Medium</option>
    <option>Large</option>
  </select>
</div>

{% schema %}
{
  "name": "Theme Elements Preview",
  "tag": "section",
  "class": "kcs-theme-elements-preview",
  "settings": [],
  "presets": [
    {
      "name": "Theme Elements Preview"
    }
  ]
}
{% endschema %}

