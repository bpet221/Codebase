{% doc %}
  @prompt
  Create a fully interactive two-option horizontal toggle button with working JavaScript functionality and smooth
  sliding animation. Use button elements with click event handlers. On the left, label the button "ASSEMBLED"; on the
  right, label it "UN-ASSEMBLED". When one option is selected, apply these styles: Font color: #ffffff Background color:
  #6D684E For the non-selected option: Font color: #6D684E Background color: #F8F7F6 Create a container with #F8F7F6
  background color that has 3px padding on top, left, and right sides. The active button should appear to float inside
  this container with smooth CSS transitions when switching between options. Add a sliding animation that moves the
  active button smoothly from side to side when toggling. Include JavaScript code to handle button clicks, toggle active
  states, smooth transitions, and update aria-pressed attributes for accessibility. Use rounded corners, equal width
  buttons, and add a slight shadow around the active selection. Make it mobile-responsive with proper touch targets.
  Ensure the toggle is clickable and functional in both preview and live environments with smooth animations." The key
  additions are: "smooth sliding animation" and "smooth CSS transitions" "3px padding on top, left, and right sides"
  "appear to float inside this container" "sliding animation that moves the active button smoothly from side to side",
  add in options to change font and background colors and borders, add in margin settings for active top bottom left and
  right edges.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-toggle-container-{{ ai_gen_id }} {
    display: flex;
    background-color: {{ block.settings.container_bg_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding: 3px 3px 0 3px;
    position: relative;
    max-width: 100%;
    width: {{ block.settings.toggle_width }}px;
    height: {{ block.settings.toggle_height }}px;
    box-sizing: border-box;
    {% if block.settings.container_border_width > 0 %}
      border: {{ block.settings.container_border_width }}px solid {{ block.settings.container_border_color }};
    {% endif %}
  }

  .ai-toggle-button-wrapper-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    width: 100%;
    height: 100%;
  }

  .ai-toggle-button-{{ ai_gen_id }} {
    flex: 1;
    padding: 8px 16px;
    border: none;
    background: transparent;
    color: {{ block.settings.inactive_text_color }};
    font-weight: 500;
    cursor: pointer;
    position: relative;
    z-index: 2;
    transition: color 0.3s ease;
    font-size: {{ block.settings.font_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    outline: none;
  }

  .ai-toggle-button-{{ ai_gen_id }}:focus-visible {
    outline: 2px solid {{ block.settings.focus_outline_color }};
    outline-offset: 2px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-toggle-slider-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.active_margin_top }}px;
    left: {{ block.settings.active_margin_left }}px;
    width: calc(50% - {{ block.settings.active_margin_left }}px - {{ block.settings.active_margin_right }}px);
    height: calc(100% - {{ block.settings.active_margin_top }}px - {{ block.settings.active_margin_bottom }}px);
    background-color: {{ block.settings.active_bg_color }};
    border-radius: calc({{ block.settings.border_radius }}px - 1px);
    transition: transform 0.3s ease;
    z-index: 1;
    box-shadow: 0 2px 4px rgba(0, 0, 0, {{ block.settings.shadow_opacity }});
    {% if block.settings.active_border_width > 0 %}
      border: {{ block.settings.active_border_width }}px solid {{ block.settings.active_border_color }};
    {% endif %}
  }

  .ai-toggle-button-{{ ai_gen_id }}.active {
    color: {{ block.settings.active_text_color }};
  }

  .ai-toggle-container-{{ ai_gen_id }}.right .ai-toggle-slider-{{ ai_gen_id }} {
    transform: translateX(calc(100% + {{ block.settings.active_margin_left }}px + {{ block.settings.active_margin_right }}px));
  }

  @media screen and (max-width: 749px) {
    .ai-toggle-container-{{ ai_gen_id }} {
      width: 100%;
      max-width: {{ block.settings.toggle_width }}px;
    }

    .ai-toggle-button-{{ ai_gen_id }} {
      padding: 8px 10px;
      font-size: {{ block.settings.font_size | minus: 2 }}px;
    }
  }
{% endstyle %}

<toggle-buttons-{{ ai_gen_id }}
  class="ai-toggle-container-{{ ai_gen_id }} {% if block.settings.default_option == 'right' %}right{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="ai-toggle-button-wrapper-{{ ai_gen_id }}">
    <button
      type="button"
      class="ai-toggle-button-{{ ai_gen_id }} left-button {% if block.settings.default_option == 'left' %}active{% endif %}"
      aria-pressed="{% if block.settings.default_option == 'left' %}true{% else %}false{% endif %}"
    >
      {{ block.settings.left_label }}
    </button>

    <button
      type="button"
      class="ai-toggle-button-{{ ai_gen_id }} right-button {% if block.settings.default_option == 'right' %}active{% endif %}"
      aria-pressed="{% if block.settings.default_option == 'right' %}true{% else %}false{% endif %}"
    >
      {{ block.settings.right_label }}
    </button>

    <div class="ai-toggle-slider-{{ ai_gen_id }}"></div>
  </div>
</toggle-buttons-{{ ai_gen_id }}>

<script>
                (function() {
                  class ToggleButtons{{ ai_gen_id }} extends HTMLElement {
                    constructor() {
                      super();
                      this.leftButton = this.querySelector('.left-button');
                      this.rightButton = this.querySelector('.right-button');
                      this.container = this;
                      this.setupEventListeners();
                    }

                    connectedCallback() {
      // Ensure the correct initial state
      this.updateToggleState();

      // Set initial group visibility with longer delay and error handling
      setTimeout(() => {
        try {
          if (this.container.classList.contains('right')) {
            this.hideShowGroup('unassembled');
          } else {
            this.hideShowGroup('assembled');
          }
        } catch (error) {
          console.log('Error setting initial group state:', error);
          // Try again with longer delay
          setTimeout(() => {
            try {
              if (this.container.classList.contains('right')) {
                this.hideShowGroup('unassembled');
              } else {
                this.hideShowGroup('assembled');
              }
            } catch (e) {
              console.log('Second attempt failed:', e);
            }
          }, 500);
        }
      }, 250);
    }



                    setupEventListeners() {
                      this.leftButton.addEventListener('click', () => this.setActive('left'));
                      this.rightButton.addEventListener('click', () => this.setActive('right'));
                    }

                   setActive(position) {
                if (position === 'left') {
                  this.container.classList.remove('right');
                  this.leftButton.classList.add('active');
                  this.rightButton.classList.remove('active');
                  this.leftButton.setAttribute('aria-pressed', 'true');
                  this.rightButton.setAttribute('aria-pressed', 'false');
                  this.hideShowGroup('assembled');
                } else {
                  this.container.classList.add('right');
                  this.rightButton.classList.add('active');
                  this.leftButton.classList.remove('active');
                  this.rightButton.setAttribute('aria-pressed', 'true');
                  this.leftButton.setAttribute('aria-pressed', 'false');
                  this.hideShowGroup('unassembled');
                }

                // Dispatch a custom event that can be listened to by other components
                const event = new CustomEvent('toggle-change', {
                  detail: { position: position },
                  bubbles: true
                });
                this.dispatchEvent(event);
              }


                    updateToggleState() {
                      if (this.container.classList.contains('right')) {
                        this.rightButton.classList.add('active');
                        this.leftButton.classList.remove('active');
                        this.rightButton.setAttribute('aria-pressed', 'true');
                        this.leftButton.setAttribute('aria-pressed', 'false');
                      } else {
                        this.leftButton.classList.add('active');
                        this.rightButton.classList.remove('active');
                        this.leftButton.setAttribute('aria-pressed', 'true');
                        this.rightButton.setAttribute('aria-pressed', 'false');
                      }
                    }

                    hideShowGroup(selectedOption) {
         // Group to hide when ASSEMBLED (left) is selected
  const assembledPriceGroup = document.querySelector('[class*="__text_WqXped"]')?.closest('[data-testid="group-block"]');

  // Group to hide when UN-ASSEMBLED (right) is selected
  const unassembledPriceGroup = document.querySelector('[class*="__text_T4yGmc"]')?.closest('[data-testid="group-block"]');

          if (selectedOption === 'assembled') {
            // Hide the first group, show the second group
            if (assembledPriceGroup) assembledPriceGroup.style.display = 'none';
            if (unassembledPriceGroup) unassembledPriceGroup.style.display = 'block';
          } else {
            // Show the first group, hide the second group
            if (assembledPriceGroup) assembledPriceGroup.style.display = 'block';
            if (unassembledPriceGroup) unassembledPriceGroup.style.display = 'none';
          }
        }




                  }

                  customElements.define('toggle-buttons-{{ ai_gen_id }}', ToggleButtons{{ ai_gen_id }});
                })();
</script>

{% schema %}
