{% doc %}
  @prompt
    Create a responsive table block (2 cols, 5 rows default). Include settings to add/remove rows, toggle header row, and customize dividers/borders (vertical interior, horizontal interior, outer) with weight, style, color, transparency. Use Shopify typography schema: select “type_preset” (rte, paragraph, h1–h6, custom); when custom, show settings for “font” (var(--font-body--family), var(--font-subheading--family), var(--font-heading--family), var(--font-accent--family)), “font_size”, “letter_spacing”, “line_height”, “case”, “color”. Inherit theme layout settings (width, max_width, alignment, padding, background).

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
.ai-table-container-{{ ai_gen_id }} {
  width: 100%;
  overflow-x: auto;
  padding: {{ block.settings.padding }}px;
  background-color: {{ block.settings.background_color }};
  border-radius: {{ block.settings.border_radius }}px;
}

.ai-table-{{ ai_gen_id }} {
  width: 100%;
  border-collapse: {{ block.settings.border_collapse }};
  border-spacing: {{ block.settings.border_spacing }}px;
}

{% if block.settings.outer_border_enabled %}
  .ai-table-{{ ai_gen_id }} {
    border: {{ block.settings.outer_border_width }}px {{ block.settings.outer_border_style }} {{ block.settings.outer_border_color }};
  }
{% endif %}

{% if block.settings.horizontal_dividers_enabled %}
  .ai-table-{{ ai_gen_id }} tr:not(:last-child) td,
  .ai-table-{{ ai_gen_id }} tr:not(:last-child) th {
    border-bottom: {{ block.settings.horizontal_divider_width }}px {{ block.settings.horizontal_divider_style }} {{ block.settings.horizontal_divider_color }};
  }
{% endif %}

{% if block.settings.vertical_dividers_enabled %}
  .ai-table-{{ ai_gen_id }} td:not(:last-child),
  .ai-table-{{ ai_gen_id }} th:not(:last-child) {
    border-right: {{ block.settings.vertical_divider_width }}px {{ block.settings.vertical_divider_style }} {{ block.settings.vertical_divider_color }};
  }
{% endif %}

.ai-table-{{ ai_gen_id }} th,
.ai-table-{{ ai_gen_id }} td {
  padding: {{ block.settings.cell_padding }}px;
  text-align: {{ block.settings.text_alignment }};
}

{% if block.settings.header_enabled %}
  .ai-table-{{ ai_gen_id }} th {
    background-color: {{ block.settings.header_background_color }};
  }
  
  {% if block.settings.header_type_preset == 'custom' %}
    .ai-table-{{ ai_gen_id }} th {
      font-family: var(--{{ block.settings.header_font }}--family);
      font-size: {{ block.settings.header_font_size }}px;
      letter-spacing: {{ block.settings.header_letter_spacing }}px;
      line-height: {{ block.settings.header_line_height }};
      text-transform: {{ block.settings.header_case }};
      color: {{ block.settings.header_text_color }};
    }
  {% else %}
    .ai-table-{{ ai_gen_id }} th {
      font-family: var(--{{ block.settings.header_type_preset }}--font-family);
      font-size: var(--{{ block.settings.header_type_preset }}--font-size);
      letter-spacing: var(--{{ block.settings.header_type_preset }}--letter-spacing);
      line-height: var(--{{ block.settings.header_type_preset }}--line-height);
      text-transform: var(--{{ block.settings.header_type_preset }}--text-transform);
      color: {{ block.settings.header_text_color }};
    }
  {% endif %}
{% endif %}

{% if block.settings.cell_type_preset == 'custom' %}
  .ai-table-{{ ai_gen_id }} td {
    font-family: var(--{{ block.settings.cell_font }}--family);
    font-size: {{ block.settings.cell_font_size }}px;
    letter-spacing: {{ block.settings.cell_letter_spacing }}px;
    line-height: {{ block.settings.cell_line_height }};
    text-transform: {{ block.settings.cell_case }};
    color: {{ block.settings.cell_text_color }};
  }
{% else %}
  .ai-table-{{ ai_gen_id }} td {
    font-family: var(--{{ block.settings.cell_type_preset }}--font-family);
    font-size: var(--{{ block.settings.cell_type_preset }}--font-size);
    letter-spacing: var(--{{ block.settings.cell_type_preset }}--letter-spacing);
    line-height: var(--{{ block.settings.cell_type_preset }}--line-height);
    text-transform: var(--{{ block.settings.cell_type_preset }}--text-transform);
    color: {{ block.settings.cell_text_color }};
  }
{% endif %}

@media screen and (max-width: 749px) {
  .ai-table-container-{{ ai_gen_id }} {
    padding: {{ block.settings.padding | divided_by: 2 }}px;
  }
  
  .ai-table-{{ ai_gen_id }} th,
  .ai-table-{{ ai_gen_id }} td {
    padding: {{ block.settings.cell_padding | divided_by: 1.5 }}px;
  }
}
{% endstyle %}

<div class="ai-table-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <table class="ai-table-{{ ai_gen_id }}">
    {% if block.settings.header_enabled %}
      <thead>
        <tr>
          {% for i in (1..block.settings.columns) %}
            {% assign header_key = 'header_col_' | append: i %}
            <th>{{ block.settings[header_key] }}</th>
          {% endfor %}
        </tr>
      </thead>
    {% endif %}
    <tbody>
      {% for row in (1..block.settings.rows) %}
        <tr>
          {% for col in (1..block.settings.columns) %}
            {% assign cell_key = 'row_' | append: row | append: '_col_' | append: col %}
            <td>{{ block.settings[cell_key] }}</td>
          {% endfor %}
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

