{% doc %}
  @prompt
    Create a custom product page block styled for the KCS brand. The block layout should:
    
    - Show a **square product image** on the **left**
    - Display the **title**, “REFUNDABLE” and “FREE SHIPPING” badges on the **right**
    - Below that, show:
      - A crossed-out price ($49.90)
      - A live sale price ($9.99)
      - A SALE badge
    - Add a large “ADD SAMPLE TO CART” button full width at the bottom
    
    **Interactions & Styling:**
    - On hover or click of the “REFUNDABLE” badge, display fine print: *“All sample costs are refunded with cabinet purchase.”*
    - Apply KCS brand fonts and colors (see memory)
    - Use rounded corners on the entire block and image
    - Ensure layout is mobile responsive, update it so i can set min and max cab widths between 20 and 250px for both. Also add in options to edit the text styles on the title, badges, prices, and buttons. And add in corner rounding settings. and add in option to change background color and background corner rounding.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .kcs-product-sample-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.background_corner_radius }}px;
    padding: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    max-width: 100%;
  }

  .kcs-product-sample__container-{{ ai_gen_id }} {
    display: flex;
    flex-direction: row;
    gap: 20px;
    margin-bottom: 20px;
  }

  @media screen and (max-width: 749px) {
    .kcs-product-sample__container-{{ ai_gen_id }} {
      flex-direction: column;
    }
  }

  .kcs-product-sample__image-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.image_width }}px;
    height: {{ block.settings.image_height }}px;
    flex-shrink: 0;
    border-radius: {{ block.settings.image_corner_radius }}px;
    overflow: hidden;
  }

  @media screen and (max-width: 749px) {
    .kcs-product-sample__image-wrapper-{{ ai_gen_id }} {
      width: 100%;
      height: auto;
      aspect-ratio: 1/1;
    }
  }

  .kcs-product-sample__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kcs-product-sample__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f5f3eb;
  }

  .kcs-product-sample__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .kcs-product-sample__content-{{ ai_gen_id }} {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .kcs-product-sample__title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 12px 0;
    line-height: 1.2;
    {% if block.settings.title_transform == 'uppercase' %}
      text-transform: uppercase;
    {% endif %}
  }

  .kcs-product-sample__badges-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .kcs-product-sample__badge-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 12px;
    border-radius: {{ block.settings.badge_corner_radius }}px;
    font-family: {{ block.settings.badge_font }};
    font-size: {{ block.settings.badge_size }}px;
    font-weight: {{ block.settings.badge_weight }};
    {% if block.settings.badge_transform == 'uppercase' %}
      text-transform: uppercase;
    {% endif %}
    letter-spacing: 0.5px;
  }

  .kcs-product-sample__badge--refundable-{{ ai_gen_id }} {
    background-color: #b8866e;
    color: #35312e;
    cursor: pointer;
    position: relative;
  }

  .kcs-product-sample__badge--shipping-{{ ai_gen_id }} {
    background-color: #f5f3eb;
    color: #35312e;
  }

  .kcs-product-sample__badge--sale-{{ ai_gen_id }} {
    background-color: #af5a3c;
    color: #ffffff;
  }

  .kcs-product-sample__refund-tooltip-{{ ai_gen_id }} {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 220px;
    padding: 10px;
    background-color: #fcfaf6;
    border: 1px solid #f5f3eb;
    border-radius: 5px;
    font-size: 12px;
    color: #35312e;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    z-index: 10;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease-in-out, visibility 0.2s ease-in-out;
    text-transform: none;
    font-weight: normal;
    letter-spacing: normal;
  }

  .kcs-product-sample__badge--refundable-{{ ai_gen_id }}:hover .kcs-product-sample__refund-tooltip-{{ ai_gen_id }},
  .kcs-product-sample__badge--refundable-{{ ai_gen_id }}.active .kcs-product-sample__refund-tooltip-{{ ai_gen_id }} {
    opacity: 1;
    visibility: visible;
  }

  .kcs-product-sample__pricing-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
  }

  .kcs-product-sample__price-regular-{{ ai_gen_id }} {
    font-family: {{ block.settings.price_font }};
    font-size: {{ block.settings.regular_price_size }}px;
    font-weight: {{ block.settings.price_weight }};
    color: {{ block.settings.regular_price_color }};
    text-decoration: line-through;
    opacity: 0.7;
  }

  .kcs-product-sample__price-sale-{{ ai_gen_id }} {
    font-family: {{ block.settings.price_font }};
    font-size: {{ block.settings.sale_price_size }}px;
    font-weight: {{ block.settings.price_weight }};
    color: {{ block.settings.sale_price_color }};
  }

  .kcs-product-sample__button-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 14px 20px;
    margin-top: 16px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_corner_radius }}px;
    font-family: {{ block.settings.button_font }};
    font-size: {{ block.settings.button_size }}px;
    font-weight: {{ block.settings.button_weight }};
    {% if block.settings.button_transform == 'uppercase' %}
      text-transform: uppercase;
    {% endif %}
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: background-color 0.2s ease-in-out;
  }

  .kcs-product-sample__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }
{% endstyle %}

<div class="kcs-product-sample-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="kcs-product-sample__container-{{ ai_gen_id }}">
    <div class="kcs-product-sample__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.product_image %}
        <img 
          src="{{ block.settings.product_image | image_url: width: 400 }}"
          alt="{{ block.settings.product_image.alt | escape }}"
          loading="lazy"
          class="kcs-product-sample__image-{{ ai_gen_id }}"
          width="{{ block.settings.product_image.width }}"
          height="{{ block.settings.product_image.height }}"
        >
      {% else %}
        <div class="kcs-product-sample__image-placeholder-{{ ai_gen_id }}">
          {{ 'product-apparel-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="kcs-product-sample__content-{{ ai_gen_id }}">
      <h3 class="kcs-product-sample__title-{{ ai_gen_id }}">{{ block.settings.product_title }}</h3>
      
      <div class="kcs-product-sample__badges-{{ ai_gen_id }}"><div class="kcs-product-sample__badge-{{ ai_gen_id }} kcs-product-sample__badge--refundable-{{ ai_gen_id }}">
          Refundable
          <div class="kcs-product-sample__refund-tooltip-{{ ai_gen_id }}">
            All sample costs are refunded with cabinet purchase.
          </div>
        </div>
        <div class="kcs-product-sample__badge-{{ ai_gen_id }} kcs-product-sample__badge--shipping-{{ ai_gen_id }}">Free Shipping</div>
      </div>
      
      <div class="kcs-product-sample__pricing-{{ ai_gen_id }}">
        <span class="kcs-product-sample__price-regular-{{ ai_gen_id }}">{{ block.settings.regular_price }}</span>
        <span class="kcs-product-sample__price-sale-{{ ai_gen_id }}">{{ block.settings.sale_price }}</span>
        <div class="kcs-product-sample__badge-{{ ai_gen_id }} kcs-product-sample__badge--sale-{{ ai_gen_id }}">Sale</div>
      </div>
    </div>
  </div>
  
  <button class="kcs-product-sample__button-{{ ai_gen_id }}">
    {{ block.settings.button_text }}
  </button>
</div>

<script>
  (function() {
    class KCSProductSample extends HTMLElement {
      constructor() {
        super();
        this.refundableBadge = this.querySelector('.kcs-product-sample__badge--refundable-{{ ai_gen_id }}');
        this.addToCartButton = this.querySelector('.kcs-product-sample__button-{{ ai_gen_id }}');
      }

      connectedCallback() {
        if (this.refundableBadge) {
          this.refundableBadge.addEventListener('click', this.toggleRefundTooltip.bind(this));
        }
        
        if (this.addToCartButton) {
          this.addToCartButton.addEventListener('click', this.addSampleToCart.bind(this));
        }
      }

      toggleRefundTooltip(event) {
        this.refundableBadge.classList.toggle('active');
        event.stopPropagation();
        
        // Close tooltip when clicking elsewhere
        const closeTooltip = (e) => {
          if (!this.refundableBadge.contains(e.target)) {
            this.refundableBadge.classList.remove('active');
            document.removeEventListener('click', closeTooltip);
          }
        };
        
        document.addEventListener('click', closeTooltip);
      }

      addSampleToCart() {
        // Here you would add the sample to cart
        // This is a placeholder for the actual cart functionality
        const productId = '{{ block.settings.product_id }}';
        if (productId) {
          // Example of how you might add to cart
          // This would need to be replaced with actual cart API calls
          console.log('Adding sample to cart: ' + productId);
        }
      }
    }

    customElements.define('kcs-product-sample-{{ ai_gen_id }}', KCSProductSample);
    document.querySelector('.kcs-product-sample-{{ ai_gen_id }}').outerHTML = 
      '<kcs-product-sample-{{ ai_gen_id }}>' + 
      document.querySelector('.kcs-product-sample-{{ ai_gen_id }}').innerHTML + 
      '</kcs-product-sample-{{ ai_gen_id }}>';
  })();
</script>

