{% doc %}
  @prompt
    Create a custom product page block for KCS brand with square product image on left and product details on right. Include title, "REFUNDABLE" and "FREE SHIPPING" badges, crossed-out price ($49.90), sale price ($9.99), SALE badge, and full-width "ADD SAMPLE TO CART" button. Add hover tooltip for REFUNDABLE badge showing "All sample costs are refunded with cabinet purchase." Make it mobile responsive with settings for: min/max cabinet widths (20-250px), text style options for title/badges/prices/buttons, corner rounding controls for block and image, background color picker, and background corner rounding. Use inherited theme fonts and colors with proper CSS inheritance instead of font dropdowns., update so the font styles are inherited from theme settings. 
    
    Add a title to "Door Samples". 
    
    Set the image default height and width to 45px x 45px. 
    
    Put the image and title on same row 1 next to each other. Image left title right. 
    
    Next row put the refundable and free shipping badges next to each other. 
    
    next row put discounted price then price then sale badge next all next to eachother. 
    
    next row full width add to cart badge., remove sale badge and put the add to cart badge to right of price., add a place to edit and add the image, put the badges under the title so they are now on the same row as the image. Add in font size settings for all fonts., move prices to a 3rd col to the right of of the title/badge rows. The 3rd column will be 1 row and will contain the prices., i need the crossed out price and price on same line and i need the font sizes settings for each separately., Update the "ADD SAMPLE TO CART" button to match the collection page product hover style. The button should initially show just a shopping bag icon with a plus sign. On hover, the button should smoothly expand to reveal the full "ADD SAMPLE TO CART" text while keeping the icon visible. Use the same animation timing, styling, and visual effects as the native collection page product buttons for consistency with the theme's existing design patterns.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .kcs-product-sample-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.background_corner_radius }}px;
    padding: 20px;
    margin-bottom: 20px;
    width: 100%;
    box-sizing: border-box;
    gap: 15px;
  }

  .kcs-product-sample__main-row-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    gap: 15px;}

  .kcs-product-sample__left-section-{{ ai_gen_id }} {
    display: flex;
    gap: 15px;
    flex-grow: 1;
  }

  .kcs-product-sample__image-container-{{ ai_gen_id }} {
    width: 45px;
    height: 45px;
    min-width: 45px;
    flex-shrink: 0;
    position: relative;
  }

  .kcs-product-sample__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.image_corner_radius }}px;
  }

  .kcs-product-sample__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f5f3eb;
    border-radius: {{ block.settings.image_corner_radius }}px;
  }

  .kcs-product-sample__image-placeholder-{{ ai_gen_id }} svg {
    width: 80%;
    height: 80%;
  }

  .kcs-product-sample__content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
  }

  .kcs-product-sample__title-{{ ai_gen_id }} {
    margin: 0;
    text-transform: {{ block.settings.title_transform }};
    font-size: {{ block.settings.title_font_size }}px;}

  .kcs-product-sample__badges-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .kcs-product-sample__badge-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 5px;
    text-transform: {{ block.settings.badge_transform }};
    background-color: #f5f3eb;
    font-size: {{ block.settings.badge_font_size }}px;
  }

  .kcs-product-sample__badge--refundable-{{ ai_gen_id }} {
    position: relative;
    cursor: help;
  }

  .kcs-product-sample__tooltip-{{ ai_gen_id }} {
    visibility: hidden;
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    width: 200px;
    background-color: #35312e;
    color: #ffffff;
    text-align: center;
    padding: 8px;
    border-radius: 6px;
    font-size: 12px;
    z-index: 1;
    opacity: 0;
    transition: opacity 0.3s;pointer-events: none;margin-bottom: 5px;
    text-transform: none;
    font-weight: normal;
  }

  .kcs-product-sample__tooltip-{{ ai_gen_id }}::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    margin-left: -5px;
    border-width: 5px;
    border-style: solid;
    border-color: #35312e transparent transparent transparent;
  }

  .kcs-product-sample__badge--refundable-{{ ai_gen_id }}:hover .kcs-product-sample__tooltip-{{ ai_gen_id }} {
    visibility: visible;
    opacity: 1;
  }

  .kcs-product-sample__price-container-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    min-width: 100px;
    text-align: right;
  }

  .kcs-product-sample__price-regular-{{ ai_gen_id }} {
    text-decoration: line-through;
    color: #666;
    font-size: {{ block.settings.regular_price_font_size }}px;
  }

  .kcs-product-sample__price-sale-{{ ai_gen_id }} {
    color: #af5a3c;
    font-size: {{ block.settings.sale_price_font_size }}px;
    font-weight: bold;
  }

  .kcs-product-sample__button-container-{{ ai_gen_id }} {
    margin-top: 10px;
  }

  .kcs-product-sample__button-{{ ai_gen_id }} {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #af5a3c;
    color: #ffffff;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    font-size: {{ block.settings.button_font_size }}px;
    text-transform: {{ block.settings.button_transform }};
    overflow: hidden;
    width: 48px;
    height: 48px;
    padding: 0;
  }

  .kcs-product-sample__button-{{ ai_gen_id }}:hover {
    background-color: #35312e;
    width: 100%;
    padding: 12px 20px;
  }

  .kcs-product-sample__button-icon-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .kcs-product-sample__button-text-{{ ai_gen_id }} {
    opacity: 0;
    width: 0;
    overflow: hidden;
    white-space: nowrap;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    margin-left: 0;
  }

  .kcs-product-sample__button-{{ ai_gen_id }}:hover .kcs-product-sample__button-text-{{ ai_gen_id }} {
    opacity: 1;
    width: auto;
    margin-left: 8px;
  }

  .kcs-product-sample__button-{{ ai_gen_id }}:focus {
    outline: 2px solid #af5a3c;
    outline-offset: 2px;
  }

  @media screen and (max-width: 768px) {
    .kcs-product-sample-{{ ai_gen_id }} {
      padding: 15px;
    }
    
    .kcs-product-sample__main-row-{{ ai_gen_id }} {
      flex-direction: column;}
    
    .kcs-product-sample__price-container-{{ ai_gen_id }} {
      align-items: flex-start;
      margin-top: 10px;
      text-align: left;
    }

    .kcs-product-sample__button-{{ ai_gen_id }} {
      width: 100%;
      padding: 12px 20px;height: auto;
    }

    .kcs-product-sample__button-text-{{ ai_gen_id }} {
      opacity: 1;
      width: auto;
      margin-left: 8px;
    }
  }
{% endstyle %}<div class="kcs-product-sample-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="kcs-product-sample__main-row-{{ ai_gen_id }}">
    <div class="kcs-product-sample__left-section-{{ ai_gen_id }}">
      <div class="kcs-product-sample__image-container-{{ ai_gen_id }}">
        {% if block.settings.custom_image %}
          <img 
            src="{{ block.settings.custom_image | image_url: width: 90 }}" 
            alt="{{ block.settings.title | escape }}" 
            class="kcs-product-sample__image-{{ ai_gen_id }}"
            width="45"
            height="45"
            loading="lazy"
          >
        {% else %}
          <div class="kcs-product-sample__image-placeholder-{{ ai_gen_id }}">
            {{ 'product-apparel-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div><div class="kcs-product-sample__content-{{ ai_gen_id }}">
        <h3 class="kcs-product-sample__title-{{ ai_gen_id }}">{{ block.settings.title }}</h3>
        <div class="kcs-product-sample__badges-{{ ai_gen_id }}"><div class="kcs-product-sample__badge-{{ ai_gen_id }} kcs-product-sample__badge--refundable-{{ ai_gen_id }}">
            {{ block.settings.refundable_text }}
            <span class="kcs-product-sample__tooltip-{{ ai_gen_id }}">{{ block.settings.refundable_tooltip }}</span>
          </div>
          <div class="kcs-product-sample__badge-{{ ai_gen_id }}">{{ block.settings.shipping_text }}</div>
        </div></div>
    </div>
    <div class="kcs-product-sample__price-container-{{ ai_gen_id }}">
      <span class="kcs-product-sample__price-regular-{{ ai_gen_id }}">{{ block.settings.regular_price }}</span>
      <span class="kcs-product-sample__price-sale-{{ ai_gen_id }}">{{ block.settings.sale_price }}</span>
    </div>
  </div>
  <div class="kcs-product-sample__button-container-{{ ai_gen_id }}">
    <button class="kcs-product-sample__button-{{ ai_gen_id }}" aria-label="{{ block.settings.button_text }}">
      <span class="kcs-product-sample__button-icon-{{ ai_gen_id }}"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M19 7H16V6C16 4.34315 14.6569 3 13 3H11C9.34315 3 8 4.34315 8 6V7H5C4.44772 7 4 7.44772 4 8C4 8.55228 4.44772 9 5 9H6V19C6 20.1046 6.89543 21 8 21H16C17.1046 21 18 20.1046 18 19V9H19C19.5523 9 20 8.55228 20 8C20 7.44772 19.5523 7 19 7ZM10 6C10 5.44772 10.4477 5 11 5H13C13.5523 5 14 5.44772 14 6V7H10V6ZM16 19H8V9H16V19Z" fill="currentColor"/>
          <path d="M12 11C11.4477 11 11 11.4477 11 12V16C11 16.5523 11.4477 17 12 17C12.5523 17 13 16.5523 13 16V12C13 11.4477 12.5523 11 12 11Z" fill="currentColor"/><path d="M15 12C15 11.4477 14.5523 11 14 11C13.4477 11 13 11.4477 13 12H15ZM13 12V16H15V12H13Z" fill="currentColor"/>
          <path d="M9 12C9 11.4477 9.44772 11 10 11C10.5523 11 11 11.4477 11 12H9ZM11 12V16H9V12H11Z" fill="currentColor"/><circle cx="12" cy="14" r="1" fill="currentColor"/>
          <path d="M12 13V15M11 14H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="kcs-product-sample__button-text-{{ ai_gen_id }}">{{ block.settings.button_text }}</span>
    </button>
  </div>
</div>

{% schema %}
{
  "name": "KCS Product Sample",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "custom_image",
      "label": "Custom image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Door Samples"
    },
    {
      "type": "text",
      "id": "refundable_text",
      "label": "Refundable badge text",
      "default": "REFUNDABLE"
    },
    {
      "type": "text",
      "id": "refundable_tooltip",
      "label": "Refundable tooltip text",
      "default": "All sample costs are refunded with cabinet purchase."
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Shipping badge text",
      "default": "FREE SHIPPING"
    },
    {
      "type": "text",
      "id": "sale_price",
      "label": "Sale price",
      "default": "$9.99"
    },
    {
      "type": "text",
      "id": "regular_price",
      "label": "Regular price",
      "default": "$49.90"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "ADD SAMPLE TO CART"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Title font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "min": 8,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Badge font size",
      "default": 12
    },
    {
      "type": "range",
      "id": "sale_price_font_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Sale price font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "regular_price_font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Regular price font size",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Button font size",
      "default": 14
    },
    {
      "type": "select",
      "id": "title_transform",
      "label": "Title text transform",
      "options": [
        {"value": "none", "label": "None"},
        {"value": "uppercase", "label": "Uppercase"},
        {"value": "lowercase", "label": "Lowercase"},
        {"value": "capitalize", "label": "Capitalize"}
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "badge_transform",
      "label": "Badge text transform",
      "options": [
        {"value": "none", "label": "None"},
        {"value": "uppercase", "label": "Uppercase"},
        {"value": "lowercase", "label": "Lowercase"},
        {"value": "capitalize", "label": "Capitalize"}
      ],
      "default": "uppercase"
    },
    {
      "type": "select",
      "id": "button_transform",
      "label": "Button text transform",
      "options": [
        {"value": "none", "label": "None"},
        {"value": "uppercase", "label": "Uppercase"},
        {"value": "lowercase", "label": "Lowercase"},
        {"value": "capitalize", "label": "Capitalize"}
      ],
      "default": "uppercase"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#fcfaf6"
    },
    {
      "type": "range",
      "id": "background_corner_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Background corner radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "image_corner_radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Image corner radius",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "KCS Product Sample"
    }
  ]
}
{% endschema %}