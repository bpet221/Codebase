{% doc %}
  @prompt
    Make a block that has a table I can add to my webpage. The table will let me customize the number of rows and columns. And will let me custom table divider and border weights, colors, and transparency individually., Header row needs to be hideable., colors needs to have a transparency setting option. Font family, weights, spacing, colors, and other styles must be individually editable by column.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-table-container-{{ ai_gen_id }} {
    overflow-x: auto;
    margin: {{ block.settings.margin }}px 0;
  }

  .ai-table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: {{ block.settings.border_collapse }};
    border-spacing: {{ block.settings.border_spacing }}px;
    background-color: {{ block.settings.table_background_color | color_modify: 'alpha', block.settings.table_background_opacity | divided_by: 100.0 }};
    border: {{ block.settings.outer_border_weight }}px {{ block.settings.outer_border_style }} {{ block.settings.outer_border_color | color_modify: 'alpha', block.settings.outer_border_opacity | divided_by: 100.0 }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-table-{{ ai_gen_id }} th {
    background-color: {{ block.settings.header_background_color | color_modify: 'alpha', block.settings.header_background_opacity | divided_by: 100.0 }};
    color: {{ block.settings.header_text_color }};
    font-weight: {{ block.settings.header_font_weight }};
    text-align: {{ block.settings.header_alignment }};
    padding: {{ block.settings.cell_padding }}px;
    border-bottom: {{ block.settings.header_border_weight }}px {{ block.settings.header_border_style }} {{ block.settings.header_border_color | color_modify: 'alpha', block.settings.header_border_opacity | divided_by: 100.0 }};
    font-family: {{ block.settings.header_font_family }};
    font-size: {{ block.settings.header_font_size }}px;
    letter-spacing: {{ block.settings.header_letter_spacing }}px;
  }

  .ai-table-{{ ai_gen_id }} td {
    padding: {{ block.settings.cell_padding }}px;
    {% if block.settings.alternating_rows %}
      background-color: {{ block.settings.cell_background_color | color_modify: 'alpha', block.settings.cell_background_opacity | divided_by: 100.0 }};
    {% endif %}
  }

  {% if block.settings.alternating_rows %}
    .ai-table-{{ ai_gen_id }} tr:nth-child(even) td {
      background-color: {{ block.settings.alternating_row_color | color_modify: 'alpha', block.settings.alternating_row_opacity | divided_by: 100.0 }};
    }
  {% else %}
    .ai-table-{{ ai_gen_id }} td {
      background-color: {{ block.settings.cell_background_color | color_modify: 'alpha', block.settings.cell_background_opacity | divided_by: 100.0 }};
    }
  {% endif %}

  .ai-table-{{ ai_gen_id }} tr:not(:last-child) td {
    border-bottom: {{ block.settings.row_divider_weight }}px {{ block.settings.row_divider_style }} {{ block.settings.row_divider_color | color_modify: 'alpha', block.settings.row_divider_opacity | divided_by: 100.0 }};
  }

  /* Column specific styles */
  {% for i in (1..6) %}
    .ai-table-{{ ai_gen_id }} td:nth-child({{ i }}),
    .ai-table-{{ ai_gen_id }} th:nth-child({{ i }}) {
      {% assign col_align_key = 'col_' | append: i | append: '_alignment' %}
      {% assign col_width_key = 'col_' | append: i | append: '_width' %}
      {% assign col_font_key = 'col_' | append: i | append: '_font_family' %}
      {% assign col_size_key = 'col_' | append: i | append: '_font_size' %}
      {% assign col_weight_key = 'col_' | append: i | append: '_font_weight' %}
      {% assign col_spacing_key = 'col_' | append: i | append: '_letter_spacing' %}
      {% assign col_color_key = 'col_' | append: i | append: '_text_color' %}
      text-align: {{ block.settings[col_align_key] }};
      {% if block.settings[col_width_key] > 0 %}
        width: {{ block.settings[col_width_key] }}%;
      {% endif %}
      font-family: {{ block.settings[col_font_key] }};
      font-size: {{ block.settings[col_size_key] }}px;
      font-weight: {{ block.settings[col_weight_key] }};
      letter-spacing: {{ block.settings[col_spacing_key] }}px;
      color: {{ block.settings[col_color_key] }};
    }
  {% endfor %}

  /* Column dividers */
  {% for i in (1..5) %}
    .ai-table-{{ ai_gen_id }} td:nth-child({{ i }}),
    .ai-table-{{ ai_gen_id }} th:nth-child({{ i }}) {
      border-right: {{ block.settings.column_divider_weight }}px {{ block.settings.column_divider_style }} {{ block.settings.column_divider_color | color_modify: 'alpha', block.settings.column_divider_opacity | divided_by: 100.0 }};
    }
  {% endfor %}

  @media screen and (max-width: 749px) {
    .ai-table-{{ ai_gen_id }} {
      font-size: 0.9em;
    }
    
    .ai-table-{{ ai_gen_id }} th,
    .ai-table-{{ ai_gen_id }} td {
      padding: {{ block.settings.cell_padding | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-table-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <table class="ai-table-{{ ai_gen_id }}">
    {% if block.settings.include_header %}
      <thead>
        <tr>
          {% for i in (1..block.settings.columns) %}
            {% assign header_key = 'header_' | append: i %}
            <th>{{ block.settings[header_key] }}</th>
          {% endfor %}
        </tr>
      </thead>
    {% endif %}
    <tbody>
      {% for row in (1..block.settings.rows) %}
        <tr>
          {% for col in (1..block.settings.columns) %}
            {% assign cell_key = 'cell_' | append: row | append: '_' | append: col %}
            <td>{{ block.settings[cell_key] }}</td>
          {% endfor %}
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

