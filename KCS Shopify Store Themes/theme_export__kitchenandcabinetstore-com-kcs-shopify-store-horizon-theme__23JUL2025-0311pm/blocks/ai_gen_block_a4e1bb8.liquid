{% doc %}
  @prompt
    Create a custom "Door Samples" product block with 3-column layout: Column 1 - editable product image (default 45px x 45px with dimension settings), Column 2 - "Door Samples" title with "REFUNDABLE" and "FREE SHIPPING" badges underneath, Column 3 - crossed-out price and sale price on same line with separate font size controls. Add hover tooltip for REFUNDABLE badge: "All sample costs are refunded with cabinet purchase." Include full-width "ADD SAMPLE TO CART" button below that starts as shopping bag + plus icon and expands on hover to show full text, matching collection page button style. Add settings for: image upload/dimensions, min/max block width (20-250px), individual font size controls for title/badges/prices/button, corner rounding for block/image, background color/rounding. Use inherited theme fonts with proper CSS inheritance. Make mobile responsive with stacked layout.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .door-sample-block-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    padding: 15px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.block_corner_radius }}px;
    width: 100%;
    max-width: {{ block.settings.block_width }}px;
    margin: 0 auto;
  }

  .door-sample-content-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
  }

  .door-sample-image-container-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.image_width }}px;
    height: {{ block.settings.image_height }}px;
    border-radius: {{ block.settings.image_corner_radius }}px;
    overflow: hidden;
  }

  .door-sample-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.image_corner_radius }}px;
  }

  .door-sample-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_corner_radius }}px;
  }

  .door-sample-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .door-sample-info-{{ ai_gen_id }} {
    flex: 1;
    min-width: 120px;
  }

  .door-sample-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 600;
    margin: 0 0 8px 0;
  }

  .door-sample-badges-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .door-sample-badge-{{ ai_gen_id }} {
    font-size: {{ block.settings.badge_font_size }}px;
    padding: 3px 8px;
    background-color: #f5f3eb;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    position: relative;
  }

  .door-sample-badge-refundable-{{ ai_gen_id }} {
    cursor: pointer;
  }

  .door-sample-tooltip-{{ ai_gen_id }} {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    background-color: #35312e;
    color: #ffffff;
    padding: 8px 12px;
    border-radius: 4px;
    font-size: 12px;
    width: max-content;
    max-width: 200px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s, visibility 0.2s;
    z-index: 10;
  }

  .door-sample-tooltip-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-width: 5px;
    border-style: solid;
    border-color: #35312e transparent transparent transparent;
  }

  .door-sample-badge-refundable-{{ ai_gen_id }}:hover .door-sample-tooltip-{{ ai_gen_id }} {
    opacity: 1;
    visibility: visible;
  }

  .door-sample-price-{{ ai_gen_id }} {
    flex: 0 0 auto;
    text-align: right;
  }

  .door-sample-compare-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.compare_price_font_size }}px;
    text-decoration: line-through;
    color: #888;
    margin-right: 5px;
  }

  .door-sample-current-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.current_price_font_size }}px;
    font-weight: 600;
    color: #af5a3c;
  }

  .door-sample-button-container-{{ ai_gen_id }} {
    margin-top: 15px;
    width: 100%;
  }

  .door-sample-button-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 10px 15px;
    background-color: #af5a3c;
    color: #ffffff;
    border: none;
    border-radius: 5px;
    font-size: {{ block.settings.button_font_size }}px;
    cursor: pointer;
    transition: background-color 0.3s;
    overflow: hidden;
    position: relative;
  }

  .door-sample-button-{{ ai_gen_id }}:hover {
    background-color: #35312e;
  }

  .door-sample-button-icon-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s;
  }

  .door-sample-button-text-{{ ai_gen_id }} {
    position: absolute;
    left: 50%;
    transform: translateX(-50%) translateY(100%);
    opacity: 0;
    transition: transform 0.3s, opacity 0.3s;
    white-space: nowrap;
  }

  .door-sample-button-{{ ai_gen_id }}:hover .door-sample-button-icon-{{ ai_gen_id }} {
    transform: translateY(-100%);
    opacity: 0;
  }

  .door-sample-button-{{ ai_gen_id }}:hover .door-sample-button-text-{{ ai_gen_id }} {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .door-sample-content-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .door-sample-image-container-{{ ai_gen_id }} {
      margin: 0 auto;
    }

    .door-sample-info-{{ ai_gen_id }},
    .door-sample-price-{{ ai_gen_id }} {
      text-align: center;
      width: 100%;
    }

    .door-sample-badges-{{ ai_gen_id }} {
      justify-content: center;
    }
  }
{% endstyle %}

<div class="door-sample-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="door-sample-content-{{ ai_gen_id }}">
    <div class="door-sample-image-container-{{ ai_gen_id }}">
      {% if block.settings.sample_image %}
        <img 
          src="{{ block.settings.sample_image | image_url: width: block.settings.image_width }}" 
          alt="{{ block.settings.title | escape }}"
          class="door-sample-image-{{ ai_gen_id }}"
          width="{{ block.settings.image_width }}"
          height="{{ block.settings.image_height }}"
          loading="lazy"
        >
      {% else %}
        <div class="door-sample-image-placeholder-{{ ai_gen_id }}">
          {{ 'product-apparel-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="door-sample-info-{{ ai_gen_id }}">
      <h3 class="door-sample-title-{{ ai_gen_id }}">{{ block.settings.title }}</h3>
      <div class="door-sample-badges-{{ ai_gen_id }}">
        <span class="door-sample-badge-{{ ai_gen_id }} door-sample-badge-refundable-{{ ai_gen_id }}">
          REFUNDABLE
          <span class="door-sample-tooltip-{{ ai_gen_id }}">{{ block.settings.refundable_tooltip }}</span>
        </span>
        <span class="door-sample-badge-{{ ai_gen_id }}">FREE SHIPPING</span>
      </div>
    </div>

    <div class="door-sample-price-{{ ai_gen_id }}">
      {% if block.settings.show_compare_price %}
        <span class="door-sample-compare-price-{{ ai_gen_id }}">{{ block.settings.compare_price_amount | money }}</span>
      {% endif %}
      <span class="door-sample-current-price-{{ ai_gen_id }}">{{ block.settings.current_price_amount | money }}</span>
    </div>
  </div>

  <div class="door-sample-button-container-{{ ai_gen_id }}">
    <button type="button" class="door-sample-button-{{ ai_gen_id }}">
      <span class="door-sample-button-icon-{{ ai_gen_id }}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 22C9.55228 22 10 21.5523 10 21C10 20.4477 9.55228 20 9 20C8.44772 20 8 20.4477 8 21C8 21.5523 8.44772 22 9 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M20 22C20.5523 22 21 21.5523 21 21C21 20.4477 20.5523 20 20 20C19.4477 20 19 20.4477 19 21C19 21.5523 19.4477 22 20 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M1 1H5L7.68 14.39C7.77144 14.8504 8.02191 15.264 8.38755 15.5583C8.75318 15.8526 9.2107 16.009 9.68 16H19.4C19.8693 16.009 20.3268 15.8526 20.6925 15.5583C21.0581 15.264 21.3086 14.8504 21.4 14.39L23 6H6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M12 9V3M9 6H15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="door-sample-button-text-{{ ai_gen_id }}">{{ block.settings.button_text }}</span>
    </button>
  </div>
</div>

{% schema %}
{
  "name": "Door Samples",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Door Samples"
    },
    {
      "type": "text",
      "id": "refundable_tooltip",
      "label": "Refundable tooltip text",
      "default": "All sample costs are refunded with cabinet purchase."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "ADD SAMPLE TO CART"
    },
    {
      "type": "image_picker",
      "id": "sample_image",
      "label": "Sample image"
    },
    {
      "type": "header",
      "content": "Pricing"
    },
    {
      "type": "checkbox",
      "id": "show_compare_price",
      "label": "Show compare price",
      "default": true
    },
    {
      "type": "text",
      "id": "compare_price_amount",
      "label": "Compare price amount",
      "default": "15.00"
    },
    {
      "type": "text",
      "id": "current_price_amount",
      "label": "Current price amount",
      "default": "10.00"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "block_width",
      "min": 200,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Block width",
      "default": 350
    },
    {
      "type": "range",
      "id": "block_corner_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Block corner radius",
      "default": 8
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Image width",
      "default": 45
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Image height",
      "default": 45
    },
    {
      "type": "range",
      "id": "image_corner_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Image corner radius",
      "default": 4
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Title font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "badge_font_size",
      "min": 8,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Badge font size",
      "default": 10
    },
    {
      "type": "range",
      "id": "compare_price_font_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Compare price font size",
      "default": 14
    },
    {
      "type": "range",
      "id": "current_price_font_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Current price font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Button font size",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "Door Samples"
    }
  ]
}
{% endschema %}