{% doc %}
  @prompt
    Create a responsive table block with 2 columns and 5 rows by default. Must include settings to add/remove rows, toggle header row visibility, and individually customize font family, weight, spacing, color, and style per column. Divider and border controls must be separate for vertical dividers, horizontal dividers, and outer borders (each with weight, color, transparency). Inherit Shopify theme typography and layout settings (e.g. width, alignment, max_width, type_preset, font, font_size, letter_spacing, padding, background, transparency color settings, etc.) like the default 'text' block does.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-table-container-{{ ai_gen_id }} {
    width: 100%;
    overflow-x: auto;
    margin: 0 auto;
    max-width: {{ block.settings.max_width }}px;
  }

  .ai-table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: {{ block.settings.border_collapse }};
    border-spacing: {{ block.settings.border_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-table-{{ ai_gen_id }} th,
  .ai-table-{{ ai_gen_id }} td {
    padding: {{ block.settings.cell_padding }}px;
    vertical-align: {{ block.settings.vertical_alignment }};
  }

  /* Header Row Styling */
  {% if block.settings.show_header %}
    .ai-table-{{ ai_gen_id }} thead th {
      background-color: {{ block.settings.header_background_color }};
      color: {{ block.settings.header_text_color }};
      font-weight: {{ block.settings.header_font_weight }};
      letter-spacing: {{ block.settings.header_letter_spacing }}px;
      text-transform: {{ block.settings.header_text_transform }};
    }
  {% endif %}

  /* Column 1 Styling */
  .ai-table-{{ ai_gen_id }} .column-1 {
    color: {{ block.settings.column_1_text_color }};
    font-weight: {{ block.settings.column_1_font_weight }};
    letter-spacing: {{ block.settings.column_1_letter_spacing }}px;
    text-transform: {{ block.settings.column_1_text_transform }};
  }

  /* Column 2 Styling */
  .ai-table-{{ ai_gen_id }} .column-2 {
    color: {{ block.settings.column_2_text_color }};
    font-weight: {{ block.settings.column_2_font_weight }};
    letter-spacing: {{ block.settings.column_2_letter_spacing }}px;
    text-transform: {{ block.settings.column_2_text_transform }};
  }

  /* Outer Border */
  {% if block.settings.show_outer_border %}
    .ai-table-{{ ai_gen_id }} {
      border: {{ block.settings.outer_border_width }}px {{ block.settings.outer_border_style }} {{ block.settings.outer_border_color }};
      border-radius: {{ block.settings.border_radius }}px;
    }
  {% endif %}

  /* Horizontal Dividers */
  {% if block.settings.show_horizontal_dividers %}
    .ai-table-{{ ai_gen_id }} tr:not(:last-child) td,
    .ai-table-{{ ai_gen_id }} tr:not(:last-child) th,
    .ai-table-{{ ai_gen_id }} thead tr th {
      border-bottom: {{ block.settings.horizontal_divider_width }}px {{ block.settings.horizontal_divider_style }} {{ block.settings.horizontal_divider_color }};
    }
  {% endif %}

  /* Vertical Dividers */
  {% if block.settings.show_vertical_dividers %}
    .ai-table-{{ ai_gen_id }} th:not(:last-child),
    .ai-table-{{ ai_gen_id }} td:not(:last-child) {
      border-right: {{ block.settings.vertical_divider_width }}px {{ block.settings.vertical_divider_style }} {{ block.settings.vertical_divider_color }};
    }
  {% endif %}

  /* Responsive styles */
  @media screen and (max-width: 749px) {
    .ai-table-container-{{ ai_gen_id }} {
      max-width: 100%;
    }
    
    .ai-table-{{ ai_gen_id }} th,
    .ai-table-{{ ai_gen_id }} td {
      padding: {{ block.settings.cell_padding | divided_by: 1.5 }}px;
    }
  }
{% endstyle %}

<div class="ai-table-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <table class="ai-table-{{ ai_gen_id }}">
    {% if block.settings.show_header %}
      <thead>
        <tr>
          <th class="column-1">{{ block.settings.header_column_1 }}</th>
          <th class="column-2">{{ block.settings.header_column_2 }}</th>
        </tr>
      </thead>
    {% endif %}
    <tbody>
      {% for i in (1..block.settings.number_of_rows) %}
        {% assign row_number = i | prepend: 'row_' %}
        {% assign cell_1_key = row_number | append: '_column_1' %}
        {% assign cell_2_key = row_number | append: '_column_2' %}
        
        <tr>
          <td class="column-1">{{ block.settings[cell_1_key] }}</td>
          <td class="column-2">{{ block.settings[cell_2_key] }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

