{% doc %}
  @prompt
    Generate a block that has a icon left aligned and to the right of it a phone number that when clicked calls 774-413-7820.  And below that a email with a icon to the left of of it left aligned too. The email is info@kitchencabinetstore.com., Color settings allow me to set transparency color value settings. Include block padding and margin adjustments for all sides.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-contact-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.item_spacing }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    padding-top: {{ block.settings.padding_top }}px;
    padding-right: {{ block.settings.padding_right }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: {{ block.settings.padding_left }}px;
    margin-top: {{ block.settings.margin_top }}px;
    margin-right: {{ block.settings.margin_right }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
    margin-left: {{ block.settings.margin_left }}px;
  }

  .ai-contact-item-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.icon_spacing }}px;
  }

  .ai-contact-icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    flex-shrink: 0;
    color: {{ block.settings.icon_color }};
  }

  .ai-contact-link-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    transition: color 0.3s ease;
  }

  .ai-contact-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.hover_color }};
    text-decoration: underline;
  }

  .ai-contact-link-{{ ai_gen_id }}:focus {
    outline: 2px solid {{ block.settings.hover_color }};
    outline-offset: 2px;
  }

  @media screen and (max-width: 749px) {
    .ai-contact-info-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top | times: 0.75 }}px;
      padding-right: {{ block.settings.padding_right | times: 0.75 }}px;
      padding-bottom: {{ block.settings.padding_bottom | times: 0.75 }}px;
      padding-left: {{ block.settings.padding_left | times: 0.75 }}px;
    }

    .ai-contact-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.9 }}px;
      height: {{ block.settings.icon_size | times: 0.9 }}px;
    }

    .ai-contact-link-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-contact-info-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-contact-item-{{ ai_gen_id }}">
    <div class="ai-contact-icon-{{ ai_gen_id }}">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
      </svg>
    </div>
    <a href="tel:{{ block.settings.phone_number }}" class="ai-contact-link-{{ ai_gen_id }}">
      {{ block.settings.phone_display }}
    </a>
  </div>

  <div class="ai-contact-item-{{ ai_gen_id }}">
    <div class="ai-contact-icon-{{ ai_gen_id }}">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
        <polyline points="22,6 12,13 2,6"></polyline>
      </svg>
    </div>
    <a href="mailto:{{ block.settings.email_address }}" class="ai-contact-link-{{ ai_gen_id }}">
      {{ block.settings.email_address }}
    </a>
  </div>
</div>

